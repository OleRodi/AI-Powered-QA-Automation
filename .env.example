# Copy this file to .env and fill in real values. NEVER commit real secrets.
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored. .env.example holds placeholders only.

# ─────────────────────────────────────────────────────────────
# Run tests — required to clone and run Playwright
# (needed for `npx playwright test`)
# ─────────────────────────────────────────────────────────────

# Base URL of the Didaxis Studio environment under test.
DIDAXIS_URL=https://test.didaxis.studio

# Login email for storageState auth (tests/auth.setup.ts).
DIDAXIS_EMAIL=your-user@example.com

# Login password for the account above.
DIDAXIS_PASSWORD=change-me

# Bearer token for the Didaxis REST API (used for data setup/cleanup).
DIDAXIS_API_TOKEN=dt_replace_with_your_api_token

# Optional — second account for permission/authorization probes.
# Leave unset if you are not running permission tests.
DIDAXIS_ALT_EMAIL=your-alt-user@example.com
DIDAXIS_ALT_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────
# Agent / CI setup — NOT needed for `npx playwright test` alone
# Used by the headless Cursor agent in
# .github/workflows/test-generation.yml. For local MCP, set these
# in Cursor settings, not here.
# ─────────────────────────────────────────────────────────────

# Cursor API key for the headless `agent` CLI in CI.
CURSOR_API_KEY=crsr_replace_with_your_key

# Atlassian (Jira) API token for the ticket-driven agent + MCP.
ATLASSIAN_API_TOKEN=replace_with_your_atlassian_token

# Base URL of your Atlassian site (trailing slash ok).
ATLASSIAN_BASE_URL=https://your-org.atlassian.net/

# Atlassian account email that owns the API token above.
ATLASSIAN_EMAIL=your-jira-user@example.com
